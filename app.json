      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "backgroundColor": "#0f172a",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/app-icon-android.png",
        "backgroundColor": "#0f172a"
      },
      "package": "com.dimalit778.champo",
      "blockedPermissions": ["android.permission.RECORD_AUDIO"]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./src/assets/app-icon-android.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin/app.plugin.js",
        {
          "iosUrlScheme": "com.googleusercontent.apps.834363700117-m3ta90sugtdcr7h6fb6ccot7e5rb2s9f"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos to choose a profile avatar.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#05070D"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.4",
            "useFrameworks": "dynamic",
            "forceStaticLinking": ["RNPurchases", "RNPaywalls"],
            "extraPods": [
              {
                "name": "AppCheckCore",
                "version": "11.2.0"
              }
            ],
            "infoPlist": {
              "NSPhotoLibraryUsageDescription": "Allow $(PRODUCT_NAME) to access your photos to choose a profile avatar.",
              "NSAppTransportSecurity": {
                "NSExceptionDomains": {
                  "keuavfvgwhwckqordjbp.supabase.co": {
                    "NSIncludesSubdomains": true,
                    "NSExceptionRequiresForwardSecrecy": true,
                    "NSExceptionMinimumTLSVersion": "TLSv1.2",
                    "NSTemporaryExceptionAllowsInsecureHTTPLoads": false
                  },
                  "sentry.io": {
                    "NSIncludesSubdomains": true,
                    "NSExceptionRequiresForwardSecrecy": true,
                    "NSExceptionMinimumTLSVersion": "TLSv1.2",
                    "NSTemporaryExceptionAllowsInsecureHTTPLoads": false
                  }
                }
              }
            }
          }
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "champoapp",
          "organization": "dima-apps"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./src/assets/app-icon-ios.png",
          "color": "#0f172a",
          "sounds": []
        }
      ],
      "expo-image",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2634cc91-a5eb-48e7-a323-c4a5dbfd03e7"
