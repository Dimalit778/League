      "bundleIdentifier": "com.dimalit778.champo",
      "buildNumber": "1",
      "userInterfaceStyle": "dark",
      "usesAppleSignIn": true,
      "icon": "./src/assets/app-icon-ios.png",
      "privacyManifests": {
