{
  "expo": {
    "name": "league",
    "slug": "leaguechampion",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/app-icon.png",
    "scheme": "league",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./src/assets/app-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dimalit778.league",
      "userInterfaceStyle": "dark",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "backgroundColor": "#0f172a",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/app-icon.png",
        "backgroundColor": "#0f172a"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.dimalit778.league"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./src/assets/app-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin/app.plugin.js",
        {
          "iosUrlScheme": "com.googleusercontent.apps.834363700117-m3ta90sugtdcr7h6fb6ccot7e5rb2s9f"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos to choose a profile avatar.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": ["photo"]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/app-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0f172a"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "extraPods": [
              {
                "name": "AppCheckCore",
                "version": "11.2.0"
              }
            ],
            "infoPlist": {
              "NSPhotoLibraryUsageDescription": "Allow $(PRODUCT_NAME) to access your photos to choose a profile avatar.",
              "NSAppTransportSecurity": {
                "NSExceptionDomains": {
                  "keuavfvgwhwckqordjbp.supabase.co": {
                    "NSIncludesSubdomains": true,
                    "NSExceptionRequiresForwardSecrecy": true,
                    "NSExceptionMinimumTLSVersion": "TLSv1.2",
                    "NSTemporaryExceptionAllowsInsecureHTTPLoads": false
                  },
                  "sentry.io": {
                    "NSIncludesSubdomains": true,
                    "NSExceptionRequiresForwardSecrecy": true,
                    "NSExceptionMinimumTLSVersion": "TLSv1.2",
                    "NSTemporaryExceptionAllowsInsecureHTTPLoads": false
                  }
                }
              }
            }
          }
        }
      ],
      "expo-secure-store",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "leaguechampion",
          "organization": "dima-apps"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./src/assets/app-icon.png",
          "color": "#0f172a",
          "sounds": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ae460131-1d9e-4bfe-9dae-4953f64f9dc2"
      }
    },
    "runtimeVersion": "1.0.0",
    "owner": "dima.dev"
  }
}
